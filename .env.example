PORT=3000
SESSION_SECRET=change-me-in-production

# GitHub OAuth (optionnel)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Tailscale
TAILSCALE_AUTH_KEY=
TAILSCALE_TAILNET=
